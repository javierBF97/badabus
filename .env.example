# Key for the base maps, free at https://carto.com/basemaps/apikey/
# Copy this file to .env and paste yours in. Without a key the map carries a watermark.
CARTO_API_KEY=

# The address the server listens on. By default it only accepts connections from this
# machine. Set it to 0.0.0.0 to open it to the local network and try it from your phone;
# do that on trusted networks only, because it exposes the app to anyone on that network.
BADABUS_HOST=
