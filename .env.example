# Clave de los mapas base, gratuita en https://carto.com/basemaps/apikey/
# Copia este fichero a .env y pega la tuya. Sin clave, el mapa se ve con marca de agua.
CARTO_API_KEY=

# Dirección en la que escucha el servidor. Por defecto solo acepta conexiones de este
# equipo. Ponlo a 0.0.0.0 para abrirlo a la red local y probarlo desde el móvil; hazlo
# solo en redes de confianza, porque expone la app a todo el que esté en esa red.
BADABUS_HOST=
